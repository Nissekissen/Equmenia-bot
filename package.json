{
    "name": "equmenia-recorder",
    "version": "0.1.0",
    "private": true,
    "description": "Discord bot that records stage channel audio",
    "main": "dist/main.js",
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "voice-poc": "tsx scripts/voice-receive-poc.ts",
        "capture-poc": "tsx scripts/capture-poc.ts",
        "raw-capture-poc": "tsx scripts/raw-capture-poc.ts",
        "build": "tsc",
        "start": "node dist/main.js",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@discordjs/opus": "^0.10.0",
        "@discordjs/voice": "^0.19.2",
        "better-sqlite3": "^13.0.3",
        "discord.js": "^14.27.0",
        "dotenv": "^16.4.5",
        "fastify": "^5.12.5",
        "ffmpeg-static": "^5.2.0",
        "prism-media": "^1.3.5",
        "sodium-native": "^4.3.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^24.19.0",
        "prettier": "^3.9.9",
        "tsx": "^4.19.1",
        "typescript": "^5.6.2"
    },
    "allowScripts": {
        "better-sqlite3@13.0.3": true,
        "esbuild@0.28.2": true,
        "ffmpeg-static@5.3.0": true,
        "fsevents@2.3.3": true,
        "@discordjs/opus@0.10.0": true
    }
}
