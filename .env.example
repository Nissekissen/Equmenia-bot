DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: set to your test server's ID during development so slash commands
# register instantly (global registration can take up to an hour to propagate).
# Leave unset in production.
DISCORD_DEV_GUILD_ID=

# Comma-separated Discord role IDs allowed to run /join and /recording
ALLOWED_ROLE_IDS=

# Where the sqlite database and recordings/ folder live (mounted as a Docker volume in prod)
DATA_DIR=./data

HTTP_PORT=3000
# Base URL the bot uses when building download links, e.g. https://recordings.example.com
PUBLIC_BASE_URL=http://localhost:3000
